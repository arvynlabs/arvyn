{
  "name": "@arvyn/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ARVYN testnet execution contracts and local verification tools.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "clean": "hardhat clean",
    "network:check": "node scripts/check-network.js",
    "deployment:estimate": "node scripts/estimate-deployment.js",
    "deployment:verify": "node scripts/verify-deployment.js",
    "execution:verify": "node scripts/verify-execution.js",
    "sandbox:verify": "node scripts/verify-sandbox.js",
    "deploy:ui": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "deploy:ui:build": "vite build --outDir cache/deploy-ui",
    "execute:ui": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "sandbox:deploy:ui": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "wallet:ui:build": "vite build --outDir cache/wallet-ui"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "ethers": "6.17.0",
    "hardhat": "3.18.1",
    "vite": "8.3.2"
  }
}
